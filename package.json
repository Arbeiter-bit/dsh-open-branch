{
  "name": "dsh-open-branch",
  "version": "0.4.0",
  "private": true,
  "description": "A writable side conversation (/side or the composer button) plus edit-and-resend for any sent message, without interrupting the main task.",
  "type": "module",
  "license": "MIT",
  "author": "Arbeiter-bit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arbeiter-bit/dsh-open-branch.git"
  },
  "homepage": "https://github.com/Arbeiter-bit/dsh-open-branch#readme",
  "bugs": {
    "url": "https://github.com/Arbeiter-bit/dsh-open-branch/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "side-chat",
    "branch"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
